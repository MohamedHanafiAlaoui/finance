rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User profile and all subcollections (transactions, goals, etc.)
    // Only the authenticated user can read and write their own data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
